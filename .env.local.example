# Copie este arquivo para ".env.local" e preencha com os valores reais.
# ".env.local" nunca é enviado ao navegador do cliente nem ao Git.

# Painel > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Painel > Project Settings > API > anon public key (pode ficar pública)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel > Project Settings > API > service_role key (SECRETA — nunca no front-end)
SUPABASE_SERVICE_ROLE_KEY=

# Senha de acesso ao painel da maquiadora (/painel)
ADMIN_PASSWORD=

# Segredo usado para assinar o cookie de sessão do painel — qualquer texto aleatório longo
ADMIN_SESSION_SECRET=
